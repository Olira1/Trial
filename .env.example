# App
NODE_ENV=development
PORT=3000
# Comma-separated CORS allow-list
ALLOWED_ORIGINS=http://localhost:3000
# Number of proxy hops to trust for req.ip (0 = trust nothing)
TRUST_PROXY=0
# Max accepted JSON / urlencoded body size (e.g. 1mb, 100kb)
JSON_BODY_LIMIT=100kb

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ubel
POSTGRES_PASSWORD=ubel
POSTGRES_DB=ubel
POSTGRES_PLATFORM=linux/arm64
DATABASE_URL=postgres://ubel:ubel@localhost:5432/ubel

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Instant Ride dispatch
# TODO(dispatch-pricing): replace the temporary hardcoded fare policy with the
# approved product pricing model before production launch.
FARE_STANDARD_RATE_MINOR_PER_KM=900
FARE_ESTIMATE_TTL_SECONDS=300
DISPATCH_OFFER_TTL_SECONDS=15
DISPATCH_ENABLE_NEW_REQUESTS=true
DISPATCH_ENABLE_NEW_MATCHING=true
DISPATCH_ENABLE_SHADOW_RANKING=false
DISPATCH_INTERNAL_RIDER_ALLOWLIST=
DISPATCH_INTERNAL_DRIVER_ALLOWLIST=
DISPATCH_ROLLOUT_PICKUP_MIN_LATITUDE=
DISPATCH_ROLLOUT_PICKUP_MAX_LATITUDE=
DISPATCH_ROLLOUT_PICKUP_MIN_LONGITUDE=
DISPATCH_ROLLOUT_PICKUP_MAX_LONGITUDE=
DISPATCH_ROLLOUT_START_HOUR_LOCAL=
DISPATCH_ROLLOUT_END_HOUR_LOCAL=
DISPATCH_ROLLOUT_TIMEZONE=Africa/Addis_Ababa
DISPATCH_MATCHING_DEADLINE_SECONDS=90
DISPATCH_ROUTING_PROVIDER_TIMEOUT_MS=3000
DISPATCH_LOCATION_UPDATE_INTERVAL_SECONDS=3
DISPATCH_LOCATION_MIN_UPDATE_INTERVAL_SECONDS=1
DISPATCH_LOCATION_FRESHNESS_SECONDS=12
DISPATCH_LOCATION_CLEANUP_TTL_SECONDS=30
DISPATCH_H3_RESOLUTION=10
DISPATCH_MAX_LOCATION_ACCURACY_METERS=50
DISPATCH_CAPTURED_AT_MAX_AGE_SECONDS=30
DISPATCH_CAPTURED_AT_MAX_FUTURE_SKEW_SECONDS=10
DISPATCH_QUEUE_PREFIX=ubel:dispatch
DISPATCH_QUEUE_DEFAULT_ATTEMPTS=3
DISPATCH_QUEUE_BACKOFF_DELAY_MS=1000
DISPATCH_QUEUE_WORKER_SHUTDOWN_TIMEOUT_MS=5000
DISPATCH_SEARCH_RADIUS_KM=3
DISPATCH_DISCOVERY_H3_RESOLUTION=9
DISPATCH_MAX_RINGS=9
DISPATCH_MAX_CANDIDATES=9

# Gebeta Maps routing (required for production routing adapter)
# GEBETA_API_KEY=your-gebeta-api-key
GEBETA_BASE_URL=https://api.gebeta.app
GEBETA_TIMEOUT_MS=3000
DISPATCH_ROUTING_MAX_CONCURRENCY=3
# 0 disables the per-process routing call rate limit
DISPATCH_ROUTING_MAX_CALLS_PER_SECOND=0

# Auth / sessions
SESSION_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MOCK_CODE=000000

# Storage (S3 or any S3-compatible service)
S3_BUCKET=ubel-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: set when pointing at a local S3-compatible service (e.g. RustFS, MinIO)
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Optional: Firebase Cloud Messaging HTTP v1 credentials
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
